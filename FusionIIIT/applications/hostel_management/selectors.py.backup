"""
Selectors for Hostel Management Module.
Contains ALL database READ operations (.objects usage).
"""
from django.db.models import Q, Count, Sum
from .models import (
    Hall, HallCaretaker, HallWarden, HallRoom, HostelLeave, HostelComplaint,
    HostelInventory, HostelFine, GuestRoom, GuestRoomBooking, StaffSchedule,
    HostelNoticeBoard, HostelStudentAttendence, HostelAllotment, StudentDetails,
    WorkerReport, HostelHistory, HostelTransactionHistory
)
from applications.globals.models import Staff, Faculty
from applications.academic_information.models import Student

# ============= HALL QUERIES =============

def get_all_halls():
    """Get all halls."""
    return Hall.objects.all()

def get_hall_by_id(hall_id):
    """Get hall by ID."""
    return Hall.objects.filter(id=hall_id).first()

def get_hall_by_hall_id(hall_id_str):
    """Get hall by hall_id string (e.g., 'hall1')."""
    return Hall.objects.filter(hall_id=hall_id_str).first()

def get_halls_with_vacancy():
    """Get halls with vacancy information."""
    return Hall.objects.all().values('id', 'hall_id', 'hall_name', 'max_accomodation', 'number_students')

def get_hall_occupancy_status(hall_id):
    """Get occupancy status of a hall."""
    hall = Hall.objects.filter(id=hall_id).first()
    if hall:
        return {
            'max_capacity': hall.max_accomodation,
            'current_students': hall.number_students,
            'vacant_seats': hall.max_accomodation - hall.number_students,
            'occupancy_percent': (hall.number_students / hall.max_accomodation * 100) if hall.max_accomodation > 0 else 0
        }
    return None

# ============= CARETAKER QUERIES =============

def get_all_caretakers():
    """Get all caretaker assignments."""
    return HallCaretaker.objects.select_related('hall', 'staff__id__user').all()

def get_caretaker_by_staff_id(staff_id):
    """Get caretaker assignment for a specific staff."""
    return HallCaretaker.objects.filter(staff_id=staff_id).select_related('hall', 'staff').first()

def get_caretaker_by_hall_id(hall_id):
    """Get caretaker(s) for a specific hall."""
    return HallCaretaker.objects.filter(hall_id=hall_id).select_related('staff__id__user').first()

def get_caretakers_by_hall_hall_id(hall_id_str):
    """Get caretaker by hall_id string."""
    hall = Hall.objects.filter(hall_id=hall_id_str).first()
    if hall:
        return HallCaretaker.objects.filter(hall=hall).select_related('staff').first()
    return None

# ============= WARDEN QUERIES =============

def get_all_wardens():
    """Get all warden assignments."""
    return HallWarden.objects.select_related('hall', 'faculty__id__user').all()

def get_warden_by_faculty_id(faculty_id):
    """Get warden assignment for a specific faculty."""
    return HallWarden.objects.filter(faculty_id=faculty_id).select_related('hall', 'faculty').first()

def get_warden_by_hall_id(hall_id):
    """Get warden for a specific hall."""
    return HallWarden.objects.filter(hall_id=hall_id).select_related('faculty__id__user').first()

# ============= ROOM QUERIES =============

def get_rooms_by_hall(hall_id):
    """Get all rooms in a specific hall."""
    return HallRoom.objects.filter(hall_id=hall_id).all()

def get_available_rooms_in_hall(hall_id):
    """Get available rooms (not full) in a hall."""
    return HallRoom.objects.filter(hall_id=hall_id, room_occupied__lt=models.F('room_cap')).all()

def get_room_by_id(room_id):
    """Get specific room by ID."""
    return HallRoom.objects.filter(id=room_id).first()

# ============= LEAVE QUERIES =============

def get_all_leaves():
    """Get all hostel leaves."""
    return HostelLeave.objects.all()

def get_leave_by_id(leave_id):
    """Get specific leave by ID."""
    return HostelLeave.objects.filter(id=leave_id).first()

def get_leaves_by_student_roll(roll_num):
