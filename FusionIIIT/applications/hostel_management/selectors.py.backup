# ============= GUEST ROOM QUERIES =============

def get_all_guest_rooms():
    """Get all guest rooms."""
    return GuestRoom.objects.all()

def get_guest_room_by_id(room_id):
    """Get specific guest room by ID."""
    return GuestRoom.objects.filter(id=room_id).first()

def get_vacant_guest_rooms():
    """Get all vacant guest rooms."""
    return GuestRoom.objects.filter(vacant=True).all()

def get_vacant_guest_rooms_by_hall(hall_id):
    """Get vacant guest rooms in specific hall."""
    return GuestRoom.objects.filter(hall_id=hall_id, vacant=True).all()

def get_occupied_guest_rooms():
    """Get all occupied guest rooms."""
    return GuestRoom.objects.filter(vacant=False).all()

# ============= GUEST ROOM BOOKING QUERIES =============

def get_all_bookings():
    """Get all guest room bookings."""
    return GuestRoomBooking.objects.all()

def get_booking_by_id(booking_id):
    """Get specific booking by ID."""
    return GuestRoomBooking.objects.filter(id=booking_id).first()

def get_bookings_by_user(user_id):
    """Get bookings by specific user."""
    return GuestRoomBooking.objects.filter(intender_id=user_id).all()

def get_bookings_by_hall(hall_id):
    """Get bookings for specific hall."""
    return GuestRoomBooking.objects.filter(hall_id=hall_id).all()

def get_pending_bookings():
    """Get all pending bookings."""
