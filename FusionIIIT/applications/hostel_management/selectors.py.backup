# ============= INVENTORY QUERIES =============

def get_all_inventories():
    """Get all inventory items."""
    return HostelInventory.objects.all()

def get_inventory_by_id(inventory_id):
    """Get specific inventory item by ID."""
    return HostelInventory.objects.filter(inventory_id=inventory_id).first()

def get_inventories_by_hall(hall_id):
    """Get inventory items for specific hall."""
    return HostelInventory.objects.filter(hall_id=hall_id).all()

def get_total_inventory_cost(hall_id):
    """Get total inventory cost for a hall."""
    return HostelInventory.objects.filter(hall_id=hall_id).aggregate(total_cost=Sum('cost'))['total_cost'] or 0

# ============= STAFF SCHEDULE QUERIES =============

def get_all_schedules():
    """Get all staff schedules."""
    return StaffSchedule.objects.select_related('staff_id__id__user', 'hall').all()

def get_schedules_by_staff(staff_id):
    """Get schedules for specific staff."""
    return StaffSchedule.objects.filter(staff_id=staff_id).select_related('hall').all()

def get_schedules_by_hall(hall_id):
    """Get all schedules for specific hall."""
    return StaffSchedule.objects.filter(hall_id=hall_id).select_related('staff_id__id__user').all()

def get_schedules_by_day(day):
    """Get schedules for specific day."""
    return StaffSchedule.objects.filter(day=day).select_related('staff_id__id__user', 'hall').all()

# ============= NOTICE BOARD QUERIES =============

def get_all_notices():
    """Get all notices."""
    return HostelNoticeBoard.objects.select_related('posted_by__user', 'hall').order_by('-id').all()

def get_notice_by_id(notice_id):
    """Get specific notice by ID."""
    return HostelNoticeBoard.objects.filter(id=notice_id).select_related('posted_by__user', 'hall').first()

def get_notices_by_hall(hall_id):
    """Get notices for specific hall."""
    return HostelNoticeBoard.objects.filter(hall_id=hall_id).select_related('posted_by__user').order_by('-id').all()

def get_recent_notices(limit=10):
    """Get recent notices."""
    return HostelNoticeBoard.objects.select_related('posted_by__user', 'hall').order_by('-id')[:limit]

