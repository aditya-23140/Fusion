    return HostelLeave.objects.filter(roll_num=roll_num).all()

def get_pending_leaves():
    """Get all pending leaves."""
    return HostelLeave.objects.filter(status='pending').all()

def get_approved_leaves():
    """Get all approved leaves."""
    return HostelLeave.objects.filter(status='Approved').all()

