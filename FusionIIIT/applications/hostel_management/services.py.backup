# ============================================================================
# TRANSACTION HISTORY HELPER
# ============================================================================

def _create_transaction_history(hall, change_type, previous_value, new_value):
    """Helper function to create transaction history records."""
    HostelTransactionHistory.objects.create(
        hall=hall,
        change_type=change_type,
        previous_value=str(previous_value)[:255],
        new_value=str(new_value)[:255]
    )
