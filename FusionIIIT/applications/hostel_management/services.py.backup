# ============================================================================
# ATTENDANCE MANAGEMENT SERVICES
# ============================================================================

@transaction.atomic
def mark_attendance(hall_id, student_id, date, present):
    """Mark student attendance."""
    hall = Hall.objects.get(id=hall_id)
    student = Student.objects.get(id=student_id)

    attendance, created = HostelStudentAttendence.objects.update_or_create(
        hall=hall,
        student_id=student,
        date=date,
        defaults={'present': present}
    )
    return attendance


@transaction.atomic
def update_attendance(attendance_id, present):
    """Update attendance record."""
    attendance = HostelStudentAttendence.objects.get(id=attendance_id)
    attendance.present = present
    attendance.save()
    return attendance


