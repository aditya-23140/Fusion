# ============================================================================
# FINE MANAGEMENT SERVICES
# ============================================================================

@transaction.atomic
def impose_fine(student_id, hall_id, student_name, amount, reason):
    """Impose a fine on a student."""
    try:
        student = Student.objects.get(id=student_id)
    except Student.DoesNotExist:
        student = None

    hall = Hall.objects.get(id=hall_id)

    fine = HostelFine.objects.create(
        student=student,
        hall=hall,
        student_name=student_name,
        amount=amount,
        reason=reason,
        status='Pending'
    )
    return fine


@transaction.atomic
def update_fine_status(fine_id, status):
    """Update fine payment status."""
    fine = HostelFine.objects.get(fine_id=fine_id)
    fine.status = status
    fine.save()
    return fine


@transaction.atomic
def delete_fine(fine_id):
    """Delete a fine record."""
    fine = HostelFine.objects.get(fine_id=fine_id)
    fine.delete()
    return True


# ============================================================================
# GUEST ROOM BOOKING SERVICES
# ============================================================================

@transaction.atomic
def create_guest_booking(hall_id, intender, guest_name, guest_phone, rooms_required,
                        total_guest, purpose, arrival_date, arrival_time,
                        departure_date, departure_time, guest_email=None,
                        guest_address=None, nationality=None, room_type='single'):
    """Create a new guest room booking."""
    hall = Hall.objects.get(id=hall_id)

    booking = GuestRoomBooking.objects.create(
        hall=hall,
        intender=intender,
        guest_name=guest_name,
        guest_phone=guest_phone,
        guest_email=guest_email or '',
        guest_address=guest_address or '',
        rooms_required=rooms_required,
        total_guest=total_guest,
        purpose=purpose,
        arrival_date=arrival_date,
        arrival_time=arrival_time,
        departure_date=departure_date,
        departure_time=departure_time,
        nationality=nationality or '',
        room_type=room_type,
        status='Pending',
        booking_date=timezone.now().date()
    )
    return booking


@transaction.atomic
def update_booking_status(booking_id, status):
    """Update the status of a guest room booking."""
    booking = GuestRoomBooking.objects.get(id=booking_id)
    booking.status = status
    booking.save()
    return booking


@transaction.atomic
def confirm_guest_booking(booking_id, guest_room_id):
    """Confirm a guest room booking and assign room."""
    booking = GuestRoomBooking.objects.get(id=booking_id)
    booking.status = 'Confirmed'
    booking.guest_room_id = guest_room_id
    booking.save()

    # Update guest room occupied status
    guest_room = GuestRoom.objects.get(id=guest_room_id)
    guest_room.vacant = False
    guest_room.occupied_till = booking.departure_date
    guest_room.save()

    return booking


@transaction.atomic
def cancel_guest_booking(booking_id):
    """Cancel a guest room booking."""
    booking = GuestRoomBooking.objects.get(id=booking_id)
    booking.status = 'Canceled'
    booking.save()

    # Update guest room if it was assigned
    if booking.guest_room_id:
        try:
            guest_room = GuestRoom.objects.get(id=booking.guest_room_id)
            guest_room.vacant = True
            guest_room.occupied_till = None
            guest_room.save()
        except GuestRoom.DoesNotExist:
            pass

    return booking


# ============================================================================
# INVENTORY MANAGEMENT SERVICES
# ============================================================================

@transaction.atomic
def add_inventory(hall_id, inventory_name, cost, quantity):
    """Add inventory item to a hall."""
    hall = Hall.objects.get(id=hall_id)

    inventory = HostelInventory.objects.create(
        hall=hall,
        inventory_name=inventory_name,
        cost=cost,
        quantity=quantity
    )
    return inventory


@transaction.atomic
def update_inventory(inventory_id, **kwargs):
    """Update inventory item details."""
    inventory = HostelInventory.objects.get(inventory_id=inventory_id)
    for key, value in kwargs.items():
        if hasattr(inventory, key):
            setattr(inventory, key, value)
    inventory.save()
    return inventory


@transaction.atomic
def delete_inventory(inventory_id):
    """Delete inventory item."""
    inventory = HostelInventory.objects.get(inventory_id=inventory_id)
    inventory.delete()
    return True


@transaction.atomic
def update_inventory_quantity(inventory_id, quantity_change):
    """Update inventory quantity (positive or negative change)."""
    inventory = HostelInventory.objects.get(inventory_id=inventory_id)
    inventory.quantity = max(0, inventory.quantity + quantity_change)
    inventory.save()
    return inventory


