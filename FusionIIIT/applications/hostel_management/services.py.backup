"""Services for Hostel Management Module.

This module contains all write operations and business logic for the Hostel Management
system. Each function handles a specific business action and may involve multiple models
and transactions. All multi-step operations use @transaction.atomic for data consistency.
"""

from django.db import transaction
from django.utils import timezone
from applications.globals.models import Staff, Faculty
from applications.academic_information.models import Student
from .models import (
    Hall, HallCaretaker, HallWarden, GuestRoomBooking, StaffSchedule,
    HostelNoticeBoard, HostelStudentAttendence, HallRoom, WorkerReport,
    HostelInventory, HostelLeave, HostelComplaint, HostelAllotment,
    StudentDetails, GuestRoom, HostelFine, HostelTransactionHistory,
    HostelHistory
)


# ============================================================================
# HALL MANAGEMENT SERVICES
# ============================================================================

@transaction.atomic
def create_hall(hall_id, hall_name, max_accommodation, type_of_seater='single',
                assigned_batch=None):
    """Create a new hall of residence."""
    hall = Hall.objects.create(
        hall_id=hall_id,
        hall_name=hall_name,
        max_accomodation=max_accommodation,
        type_of_seater=type_of_seater,
        assigned_batch=assigned_batch,
        number_students=0
    )
    return hall


@transaction.atomic
def update_hall(hall_id, **kwargs):
    """Update hall information."""
    hall = Hall.objects.get(id=hall_id)
    for key, value in kwargs.items():
        if hasattr(hall, key):
            setattr(hall, key, value)
    hall.save()
    _create_transaction_history(hall, 'Hall Update', str(hall.__dict__), str(kwargs))
    return hall


@transaction.atomic
def assign_caretaker_to_hall(hall_id, staff_id):
    """Assign a caretaker to a hall."""
    hall = Hall.objects.get(id=hall_id)
    staff = Staff.objects.get(id=staff_id)

    # Remove existing caretaker
    previous_caretaker = HallCaretaker.objects.filter(hall=hall).first()
    HallCaretaker.objects.filter(hall=hall).delete()

    # Create new assignment
    caretaker = HallCaretaker.objects.create(hall=hall, staff=staff)

    # Record transaction
    previous_value = str(previous_caretaker.staff.id.user.username) if previous_caretaker else 'None'
    _create_transaction_history(hall, 'Caretaker', previous_value, str(staff.id.user.username))

    return caretaker


@transaction.atomic
def assign_warden_to_hall(hall_id, faculty_id):
    """Assign a warden to a hall."""
    hall = Hall.objects.get(id=hall_id)
    faculty = Faculty.objects.get(id=faculty_id)

    # Remove existing warden
    previous_warden = HallWarden.objects.filter(hall=hall).first()
    HallWarden.objects.filter(hall=hall).delete()

    # Create new assignment
    warden = HallWarden.objects.create(hall=hall, faculty=faculty)

    # Record transaction
    previous_value = str(previous_warden.faculty.id.user.username) if previous_warden else 'None'
    _create_transaction_history(hall, 'Warden', previous_value, str(faculty.id.user.username))

    return warden


@transaction.atomic
def assign_batch_to_hall(hall_id, batch):
    """Assign a batch to a hall."""
    hall = Hall.objects.get(id=hall_id)
    previous_batch = hall.assigned_batch
    hall.assigned_batch = batch
    hall.save()

    # Record transaction
    _create_transaction_history(hall, 'Batch', previous_batch or 'None', batch)

    return hall


@transaction.atomic
def delete_hall(hall_id):
    """Delete a hall (soft delete via HostelHistory)."""
    hall = Hall.objects.get(id=hall_id)
    hall.delete()
    return True


# ============================================================================
# LEAVE MANAGEMENT SERVICES
# ============================================================================

@transaction.atomic
def create_leave(student_name, roll_num, reason, start_date, end_date,
                 phone_number=None, file_upload=None):
    """Create a new leave request."""
    leave = HostelLeave.objects.create(
        student_name=student_name,
        roll_num=roll_num,
        reason=reason,
        start_date=start_date,
        end_date=end_date,
        phone_number=phone_number,
        file_upload=file_upload,
        status='pending'
    )
    return leave


@transaction.atomic
def update_leave_status(leave_id, status, remark=None):
    """Update leave request status (approve/reject/pending)."""
    leave = HostelLeave.objects.get(id=leave_id)
    leave.status = status
    if remark:
        leave.remark = remark
    leave.save()
    return leave


